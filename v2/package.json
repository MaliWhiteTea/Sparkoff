{
  "name": "sparkoff-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "demo": "VITE_DEMO_MODE=true vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run check && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "bootstrap:admin": "tsx src/server/bootstrap.ts"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.10.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unzipper": "^0.12.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
